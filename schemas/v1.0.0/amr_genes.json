    },
    {
      "name": "gene_symbol",
      "type": "string",
      "nullable": false,
      "description": "AMRFinderPlus element symbol"
    },
    {
      "name": "element_name",
      "type": "string",
      "nullable": false,
      "description": "AMRFinderPlus element name"
    },
    {
      "name": "element_type",
      "type": "string",
      "nullable": false,
      "description": "AMR, STRESS or VIRULENCE"
    },
    {
      "name": "element_subtype",
      "type": "string",
      "nullable": false,
      "description": "AMR, POINT, STRESS, VIRULENCE, ..."
    },
    {
      "name": "drug_class",
      "type": "string",
      "nullable": true,
      "description": "Drug class"
