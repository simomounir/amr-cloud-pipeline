// Run every process on AWS Batch (infra/compute). Use with run-on-batch.sh, which assumes the
// amr-pipeline-runner role and sets workDir/outdir under s3://amr-pipeline-<account>/.
process {
    executor       = 'awsbatch'
    queue          = 'amr-queue'
    // Cost attribution: every Batch job is tagged with its study and run.
    resourceLabels = [Project: 'amr-cloud-pipeline', Study: params.study, Run: params.run_id]
}

aws {
    region = 'eu-west-1'
    batch {
        // Installed on every host by the launch template (infra/compute/batch.tf). Nextflow
        // mounts the CLI's install directory into each container itself; do not add it to
        // aws.batch.volumes as well (Batch rejects duplicate mount points).
        cliPath          = '/opt/aws-cli/bin/aws'
        logsGroup        = '/amr/batch'
        // Re-run a task when AWS reclaims its spot instance.
        maxSpotAttempts  = 3
    }
}

// Batch pulls and runs the containers itself; the local Docker profile does not apply.
docker.enabled = false
