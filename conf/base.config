process {
    cpus   = 1
    memory = { 2.GB * task.attempt }

    // Out-of-memory kills (137, 140) retry with more memory; anything else stops the run.
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    resourceLimits = [cpus: 4, memory: 14.GB, time: 8.h]

    // Time limits: a hung download or assembly fails its task (then retried once and skipped,
    // below) instead of holding the run until the 5.5 h Cloud run limit. Measured on Batch:
    // Shovill 5-13 min, every other step under 4 min.
    time = 1.h
    withName: 'SHOVILL' {
        time = 3.h
    }
    // Downloads straight from ENA, at most 16 at a time (be a polite client). Two files, each
    // retried from the start if a transfer breaks: allow 2 h.
    withName: 'FETCH_READS' {
        maxForks = 16
        time     = 2.h
    }

    // Per-sample steps: a broken public read set must not stop a whole study. Out-of-memory
    // retries twice with more memory, anything else once (transient download or host
    // problems); then the sample is skipped and recorded as failed (samples.analysis_status).
    withName: 'FETCH_READS|FASTP|SHOVILL|AMRFINDERPLUS_RUN|KLEBORATE|AMRTOOLS_SAMPLE' {
        errorStrategy = { task.attempt <= (task.exitStatus in [137, 140] ? 2 : 1) ? 'retry' : 'ignore' }
    }

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
}
